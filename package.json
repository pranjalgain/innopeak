{
  "name": "app-boilerplate",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "docs:dev": "pnpm --filter documentation start",
    "docs:build": "pnpm --filter documentation build",
    "docs:clear": "pnpm --filter documentation clear",
    "docs:serve": "pnpm --filter documentation serve",
    "backend:up": "pnpm --filter backend local:up",
    "backend:down": "pnpm --filter backend db:dev:rm",
    "web:dev": "pnpm --filter web dev",
    "web:start": "pnpm --filter web start",
    "web:build": "pnpm --filter web build",
    "generate:sdk": "pnpm --filter backend generate:client"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "proxy-addr@<2.0.8": "2.0.8",
      "multer@<2.3.0": "2.4.0",
      "undici@>=8.0.0 <8.10.2": "8.11.2",
      "engine.io@<6.6.10": "6.6.11",
      "path-to-regexp@<0.1.13": "0.1.13",
      "source-map-js@<1.2.2": "1.2.2",
      "@grpc/grpc-js@<1.14.5": "1.14.6",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.11": "5.0.12",
      "sharp@<0.35.5": "0.35.5",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2"
    }
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.13.5",
    "@swc/helpers": "0.5.17",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "webpack-cli": "6.0.1"
  },
  "engines": {
    "node": ">=20.0"
  }
}
