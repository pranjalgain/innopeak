**/.next
**/dist
**/coverage
**/.turbo
**/.swc
**/*.tsbuildinfo
**/.eslintcache

.git
.claude
.github
.vscode
.idea

.env
.env.*
!.env.example

**/logs
**/data
**/test-results
**/playwright-report
**/allure-results
**/artillery

infra
k3s
apps/documentation
