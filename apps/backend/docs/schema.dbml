// Google Business Profile Review Management — Schema
// Source of truth: apps/backend/src/db/drizzle/migrations/ (migrations 0000_foundation.sql through 0012_billing_receipts.sql)
// This file is a DBML export of that migration for dbdiagram.io, kept in sync with it by hand.
// To use: go to https://dbdiagram.io/d, create a new diagram, and paste this file's contents
// (or File > Import > DBML if working in an existing diagram).
//
// Target: PostgreSQL 18. All table `id` columns default to `uuidv7()` (time-ordered, PG18 core
// built-in). A few constraints from the migration can't be expressed in DBML and are called out as table
// Notes: partial/conditional unique indexes (Postgres `WHERE` clauses) and functional indexes.
//
// Open structural findings from the 2026-11 schema review (drift, missing composite tenant FKs,
// redundant indexes, unused tables) are tracked in `docs/database-schema-review.md`. This file
// describes the schema as built by the migrations above, not the recommended target state.

//////////////////////////////////////////////////////////////////////////
// Enums
//////////////////////////////////////////////////////////////////////////

Enum tenant_status {
  pending_activation
  active
  suspended
  erased
}

Enum tenant_identity_provider {
  entra_id
  google_workspace
}

Enum user_identity_provider {
  entra_id
  google
}

Enum user_role {
  owner
  member
}

Enum user_status {
  pending_verification
  invited
  active
  disabled
}

Enum token_purpose {
  verify_email
  invite
  reset
  set_password
  delete_account
}

Enum platform_admin_status {
  invited
  active
  disabled
}

Enum platform_admin_invite_purpose {
  invite
  reset
  set_password
}

// The review-SOURCE integration (Google Business Profile today; Yelp/Facebook/TripAdvisor/etc.
// later via ALTER TYPE ... ADD VALUE). Distinct from user_identity_provider above even though
// both currently contain 'google' — that one is "which IdP did this person log in with,"
// this one is "which review platform is this data from." Per-provider API/auth logic lives in
// code as separate Provider classes (ReviewProvider abstract base + GoogleBusinessProfileProvider
// first implementation), mirroring this codebase's existing Email/SMS/AI Provider pattern.
Enum review_provider {
  google
}

Enum google_connection_status {
  // Name kept as-is despite being provider-agnostic in practice — describes OAuth connection
  // health for any review_provider, not just Google.
  active
  needs_reauth
}

Enum location_status {
  active
  inactive
}

Enum sync_health_status {
  ok
  error
}

Enum review_sentiment {
  // inferred — not pinned to specific values in PLAN.md
  positive
  neutral
  negative
}

Enum review_classification {
  auto_reply_candidate
  escalated
  pending_classification
}

Enum escalation_reason {
  low_rating
  blocklist_match
}

Enum review_status {
  new
  in_review
  responded
  dismissed
  removed
}

Enum response_type {
  auto_reply_suggestion
  escalation_snippet
  imported_reply
}

Enum response_source {
  ai_generated
  human_edited
  human_manual
  imported
}

Enum response_status {
  draft
  pending_approval
  approved
  rejected
  posted
  post_failed
  superseded
}

Enum notification_type {
  escalation
}

Enum notification_channel_pref {
  email
  teams
  both
}

Enum notification_channel {
  email
  teams
}

Enum notification_status {
  // inferred — not pinned to specific values in PLAN.md
  pending
  sent
  failed
}

Enum sync_trigger {
  scheduled
  backfill
}

Enum sync_run_status {
  running
  ok
  error
}

// Which reply category a prompt is for — drives which prompt the generation pipeline selects
// for a given review. Distinct from review_classification: 'escalated' lines up 1:1, but
// review_classification's 'auto_reply_candidate' splits into 'positive'/'neutral' here with no
// column yet recording which of the two a given review is (see 0006_prompts.sql's own note and
// PLAN.md §3 — sentiment is computed but does not drive routing in MVP).
Enum prompt_category {
  positive
  neutral
  escalated
}

Enum prompt_tone {
  friendly
  professional
  formal
  playful
  empathetic
}

Enum in_app_notification_type {
  review_escalated
  reply_needs_approval
  reply_approved
  connection_issue
}

Enum media_kind {
  avatar
}

Enum billing_plan_code {
  free
  paid
}

Enum subscription_status {
  active
  past_due
  canceled
  incomplete
}

Enum subscription_cancellation_source {
  owner
  erasure
}

Enum platform_activity_type {
  business_suspended
  business_reactivated
  admin_invite_sent
  admin_invite_revoked
  user_activated
  user_deactivated
  admin_disabled
  admin_enabled
  business_erasure_requested
  business_erasure_cancelled
  business_erased
  business_joined
  platform_settings_changed
}

//////////////////////////////////////////////////////////////////////////
// Platform-level tables (not tenant-scoped)
//////////////////////////////////////////////////////////////////////////

Table platform_admins {
  id uuid [pk]
  email varchar [unique, not null]
  password_hash varchar [note: 'nullable — social-login-only admins will not have one']
  invited_by_platform_admin_id uuid [note: 'null only for the first, seeded admin']
  status platform_admin_status [not null]
  locale user_locale [note: 'NULL means the admin never chose a language; Accept-Language decides']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: '''Exactly one row is seeded at deployment time (no public signup path). Every subsequent row is created via an existing admin invite.
  Enforced at the DB level: a partial unique index on (TRUE) WHERE invited_by_platform_admin_id IS NULL guarantees at most one root row can ever exist, not expressible as a plain DBML unique.'''
}

Table platform_admin_identities {
  id uuid [pk]
  platform_admin_id uuid [not null]
  provider user_identity_provider [not null]
  provider_user_id varchar [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (provider, provider_user_id) [unique]
    platform_admin_id
  }

  Note: 'No UNIQUE (platform_admin_id, provider): an admin can currently link more than one identity per provider.'
}

// Renamed from the earlier "platform_admin_invites" in migration 0001; covers invite, reset and
// set_password for platform admins.
Table platform_admin_auth_tokens {
  id uuid [pk]
  platform_admin_id uuid [not null]
  token_hash varchar [unique, not null]
  purpose platform_admin_invite_purpose [not null]
  expires_at timestamp [not null]
  used_at timestamp [note: 'nullable; consume via UPDATE ... WHERE used_at IS NULL (compare-and-swap)']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    platform_admin_id
    (platform_admin_id, purpose) [unique, note: 'One live row per (admin, purpose)']
  }
}

//////////////////////////////////////////////////////////////////////////
// Tenant & auth
//////////////////////////////////////////////////////////////////////////

Table tenants {
  id uuid [pk]
  name varchar [not null]
  created_by_platform_admin_id uuid [note: 'null for the normal self-registration path; set only for support-assisted tenant creation']
  status tenant_status [not null, default: 'pending_activation']
  erasure_requested_at timestamp [note: 'Set when erasure is requested; NULL = none pending. Tenant suspended meanwhile']
  erasure_requested_by_user_id uuid [note: 'NULL for a platform admin request']
  erasure_reminder_sent_at timestamp
  status_before_erasure tenant_status [note: 'What tenant was before erasure request suspended it']
  last_erasure_requested_at timestamp
  last_erasure_cancelled_at timestamp
  active_location_id uuid [note: 'Added in 0003']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    created_by_platform_admin_id
    status
    created_at
    erasure_requested_at [note: 'partial where not null']
  }
}

Table tenant_identity_providers {
  id uuid [pk]
  tenant_id uuid [not null]
  provider tenant_identity_provider [not null]
  provider_tenant_id varchar [not null, note: 'the external directory/org ID for that provider']
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (provider, provider_tenant_id) [unique]
    tenant_id
  }

  Note: '''Intentionally unused until directory-wide SSO is required (see PLAN.md). The unique index is
  global, so an erased tenant that keeps this row would block the same directory being bound again.'''
}

Table users {
  id uuid [pk]
  tenant_id uuid [not null]
  name varchar [note: 'nullable — anonymization nulls PII']
  email varchar [note: 'nullable — anonymization nulls PII']
  password_hash varchar [note: 'nullable — social-login-only owners will not have one']
  email_verified_at timestamp
  invited_by_user_id uuid [note: 'null for self-registered owner; set only when member invited by owner']
  role user_role [not null]
  status user_status [not null]
  anonymized_at timestamp [note: 'GDPR erasure - row preserved for FK integrity']
  erasure_requested_at timestamp [note: 'Removal requested; access ends now, anonymization after grace period']
  status_before_removal user_status [note: 'Restored if removal cancelled']
  locale user_locale [note: 'NULL means never chosen; Accept-Language decides']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (tenant_id, email) [unique]
    email [note: 'global partial unique where anonymized_at IS NULL — one active account per email across all tenants']
    invited_by_user_id
    tenant_id
    role
    status
    created_at
    erasure_requested_at [note: 'partial where not null']
  }

  Note: '''`tenant_id` is single-valued: one person cannot currently belong to more than one tenant, despite
  the agency/multi-client case described in PLAN.md. Splitting identity from membership would need a
  `tenant_memberships` table (tracked in docs/database-schema-review.md).'''
}

Table user_identities {
  id uuid [pk]
  user_id uuid [not null]
  provider user_identity_provider [not null]
  provider_user_id varchar [not null]
  email varchar [not null, note: 'IdP claim at login time, may differ from users.email']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (provider, provider_user_id) [unique]
    user_id
  }

  Note: 'No UNIQUE (user_id, provider): a user can currently link more than one identity per provider. See docs/database-schema-review.md.'
}

Table user_auth_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar [not null]
  purpose token_purpose [not null]
  expires_at timestamp [not null]
  used_at timestamp [note: 'nullable; consume via UPDATE ... WHERE used_at IS NULL (compare-and-swap)']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    token_hash
    (user_id, purpose) [unique]
    user_id
  }

  Note: 'Covers owner email verification, member invite, forgot-password reset, set_password, delete_account. token_hash not unique alone due to OTP collisions.'
}

// Renamed from the earlier "password_reset_tokens" in migration 0002; the table is not
// reset-only. The unique (user_id, purpose) index enforces one live token per flow.

//////////////////////////////////////////////////////////////////////////
// Review provider connection & locations
//////////////////////////////////////////////////////////////////////////

Table review_provider_connections {
  id uuid [pk]
  tenant_id uuid [not null]
  connected_by_user_id uuid [not null]
  provider review_provider [not null, default: 'google']
  provider_account_id varchar [not null, note: 'e.g. the Google account ID — scoped per provider, not globally unique']
  credential_reference varchar [not null, note: 'pointer into a secrets manager, never the raw token']
  token_expires_at timestamp
  status google_connection_status [not null, default: 'active']
  disconnected_at timestamp [note: 'Owner intent (disconnected on purpose)']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (tenant_id, provider, provider_account_id) [unique]
    tenant_id
    connected_by_user_id
  }

  Note: 'At most one live connection per tenant and provider (partial unique index on tenant_id,provider WHERE disconnected_at IS NULL).'
}

Table locations {
  id uuid [pk]
  tenant_id uuid [not null]
  provider_connection_id uuid [not null]
  provider review_provider [not null, default: 'google', note: 'denormalized from review_provider_connections.provider']
  external_location_id varchar [not null]
  name varchar [not null]
  address varchar
  phone varchar [note: 'Business phone from provider']
  website_uri varchar [note: 'Business website from provider']
  category varchar [note: "Google's primary category"]
  google_rating numeric [note: "Google's overall rating"]
  google_review_count integer [note: "Google's review count"]
  details_refreshed_at timestamp [note: 'Last attempt to refresh details from provider']
  status location_status [not null, default: 'active']
  last_synced_at timestamp
  last_sync_status sync_health_status [note: 'did the most recent poll attempt succeed']
  last_sync_error text [note: 'why the most recent poll attempt failed, if it did']
  onboarding_backfill_completed_at timestamp [note: 'gates live polling/classification until backfill finishes']
  reviews_reconciled_at timestamp [note: 'Last attempt to compare Google full list with ours']
  last_review_synced_at timestamp [note: 'Poller high-water mark']
  billing_paused_at timestamp [note: 'Set when plan max_locations cap excludes this location']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (provider_connection_id, external_location_id) [unique]
    tenant_id
    provider_connection_id
    billing_paused_at [note: 'partial where not null']
  }
}

Table user_locations {
  id uuid [pk]
  user_id uuid [not null]
  location_id uuid [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (user_id, location_id) [unique]
    user_id
    location_id
  }

  Note: '''Currently write-only: rows are inserted when a location is confirmed, but location reads scope
  through `users.tenant_id`. Retained deliberately for future per-store member scoping (PLAN.md).'''
}

//////////////////////////////////////////////////////////////////////////
// Reviews & responses
//////////////////////////////////////////////////////////////////////////

Table reviews {
  id uuid [pk]
  tenant_id uuid [not null]
  location_id uuid [not null]
  external_review_id varchar [not null]
  external_reviewer_id varchar [note: 'nullable, best-effort erasure key when the provider API exposes one']
  rating integer [not null, note: 'CHECK (rating BETWEEN 1 AND 5)']
  review_text text
  reviewer_name varchar
  reviewed_at timestamp [note: 'when the reviewer originally posted on the provider']
  external_updated_at timestamp [note: 'drives edit detection on re-poll']
  sentiment review_sentiment
  classification review_classification [not null, default: 'pending_classification']
  escalation_reason escalation_reason
  matched_keywords jsonb [note: 'which blocklist term(s) matched, when escalation_reason = blocklist_match']
  status review_status [not null, default: 'new']
  anonymized_at timestamp [note: 'set once PII purged by retention job or erasure request']
  removed_upstream_at timestamp [note: 'set when the poller detects the reviewer deleted their review upstream']
  generation_attempts smallint [not null, default: 0, note: 'Retry count for AI reply generation']
  generation_failed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (location_id, external_review_id) [unique]
    tenant_id
    location_id
    status
    classification
    reviewed_at
    (tenant_id, reviewed_at) [note: 'composite for dashboard queries']
    (tenant_id, status, classification)
    external_reviewer_id
  }
}

Table review_responses {
  id uuid [pk]
  tenant_id uuid [not null]
  review_id uuid [not null]
  generation_group_id uuid [note: 'groups snippets generated together; not a foreign key to another table']
  response_type response_type [not null]
  content text [not null]
  source response_source [not null]
  status response_status [not null, default: 'draft']
  created_by_user_id uuid [note: 'null for AI-generated or imported rows']
  approved_by_user_id uuid [note: 'null until a human approves']
  rejected_by_user_id uuid
  posted_at timestamp
  error_message text
  generation_metadata jsonb [note: 'model name/version, region, token counts']
  post_attempted_at timestamp [note: "Worker's claim marker"]
  prompt_version_id uuid [note: 'which prompt_versions row generated this draft']
  original_content text [note: "AI's pre-edit text"]
  decided_at timestamp [note: 'when status became terminal']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    tenant_id
    review_id
    generation_group_id
    status
    created_by_user_id
    approved_by_user_id
    rejected_by_user_id
    prompt_version_id
  }

  Note: '''Two partial unique indexes not expressible in DBML:
  UNIQUE (review_id) WHERE status IN ('approved', 'posted') — only one reply live/in-flight per review
  UNIQUE (review_id) WHERE source = 'imported' — makes backfill idempotent'''
}

//////////////////////////////////////////////////////////////////////////
// AI reply prompts — added by 0006_prompts.sql, not yet applied to any
// database and not yet introspected into src/db/drizzle/schema.ts.
//////////////////////////////////////////////////////////////////////////

Table prompts {
  id uuid [pk]
  tenant_id uuid [not null]
  category prompt_category [not null]
  name varchar [not null]
  description varchar
  tone prompt_tone [not null, default: 'professional']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (tenant_id, category) [unique]
  }

  Note: 'One row per tenant per reply category. Template text lives on prompt_versions; tone is updated in place.'
}

Table prompt_versions {
  id uuid [pk]
  prompt_id uuid [not null]
  version integer [not null, note: 'CHECK (version > 0)']
  template varchar [not null]
  created_by_user_id uuid
  created_at timestamp [not null]

  indexes {
    (prompt_id, version) [unique]
  }

  Note: 'Append-only: every edit inserts a new row. Current version is MAX(version).'
}

//////////////////////////////////////////////////////////////////////////
// Settings & blocklist
//////////////////////////////////////////////////////////////////////////

Table tenant_settings {
  id uuid [pk]
  tenant_id uuid [not null, unique]
  escalation_rating_threshold integer [not null, default: 3, note: 'CHECK (escalation_rating_threshold BETWEEN 1 AND 5)']
  auto_post_enabled boolean [not null, default: false]
  review_data_retention_months integer [note: 'NULL = no time-based reviewer-PII purge; deliberately no platform default']
  ai_reply_count smallint [not null, default: 2, note: 'CHECK (ai_reply_count BETWEEN 1 AND 3)']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table blocklist_terms {
  id uuid [pk]
  tenant_id uuid [not null]
  term varchar [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    tenant_id
  }

  Note: 'Case-insensitive unique constraint on (tenant_id, lower(term)) via functional index, not expressible as plain DBML unique.'
}

//////////////////////////////////////////////////////////////////////////
// Notifications
//////////////////////////////////////////////////////////////////////////

Table notification_recipients {
  id uuid [pk]
  tenant_id uuid [not null]
  user_id uuid [not null]
  notification_type notification_type [not null, default: 'escalation']
  channel notification_channel_pref [not null, default: 'email', note: 'delivery preference']
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    tenant_id
    user_id
    (tenant_id, user_id, notification_type) [unique]
  }
}

Table notifications {
  id uuid [pk]
  tenant_id uuid [not null]
  review_id uuid [not null]
  recipient_user_id uuid [not null]
  generation_group_id uuid [note: 'which snippet batch was included at send time; not a foreign key']
  type notification_type [not null, default: 'escalation']
  channel notification_channel [not null]
  status notification_status [not null, default: 'pending']
  sent_at timestamp
  read_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (review_id, recipient_user_id, type, generation_group_id) [unique]
    tenant_id
    review_id
    recipient_user_id
    generation_group_id
  }

  Note: 'Scoped to include generation_group_id so re-escalation events can notify again.'
}

// Kept as scaffolding for the future email/Teams delivery ledger. No application code reads or
// writes it today; all live notifications use in_app_notifications.

//////////////////////////////////////////////////////////////////////////
// Operability
//////////////////////////////////////////////////////////////////////////

Table sync_runs {
  id uuid [pk]
  tenant_id uuid [not null]
  location_id uuid [not null]
  trigger sync_trigger [not null]
  started_at timestamp [not null, default: `now()`]
  completed_at timestamp
  status sync_run_status [not null, default: 'running']
  reviews_fetched integer
  reviews_total integer [note: 'NULL when provider reports no total']
  error_message text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    tenant_id
    location_id
    (location_id, started_at)
  }

  Note: 'Partial unique index on (location_id) WHERE status = \'running\' prevents overlapping runs. No retention job: rows accumulate indefinitely.'
}

//////////////////////////////////////////////////////////////////////////
// Relationships
//////////////////////////////////////////////////////////////////////////

Ref: users.tenant_id > tenants.id [delete: cascade]
Ref: users.invited_by_user_id > users.id [delete: set null]
Ref: review_provider_connections.tenant_id > tenants.id [delete: cascade]
Ref: review_responses.tenant_id > tenants.id [delete: cascade]
Ref: locations.tenant_id > tenants.id [delete: cascade]
Ref: reviews.tenant_id > tenants.id [delete: cascade]
Ref: tenant_settings.tenant_id - tenants.id [delete: cascade]
Ref: blocklist_terms.tenant_id > tenants.id [delete: cascade]
Ref: notification_recipients.tenant_id > tenants.id [delete: cascade]
Ref: notifications.tenant_id > tenants.id [delete: cascade]
Ref: sync_runs.tenant_id > tenants.id [delete: cascade]
Ref: tenant_identity_providers.tenant_id > tenants.id [delete: cascade]
Ref: prompts.tenant_id > tenants.id [delete: cascade]
Ref: tenants.created_by_platform_admin_id > platform_admins.id [delete: set null]

Ref: user_identities.user_id > users.id [delete: cascade]
Ref: user_auth_tokens.user_id > users.id [delete: cascade]
Ref: review_provider_connections.connected_by_user_id > users.id [delete: restrict]
Ref: review_responses.created_by_user_id > users.id [delete: set null] // created by
Ref: review_responses.approved_by_user_id > users.id [delete: set null] // approved by
Ref: notification_recipients.user_id > users.id [delete: cascade]
Ref: notifications.recipient_user_id > users.id [delete: restrict]
Ref: user_locations.user_id > users.id [delete: cascade]
Ref: prompt_versions.created_by_user_id > users.id [delete: set null]
Ref: user_locations.location_id > locations.id [delete: cascade]
Ref: locations.provider_connection_id > review_provider_connections.id [delete: cascade]
Ref: reviews.location_id > locations.id [delete: cascade]
Ref: sync_runs.location_id > locations.id [delete: cascade]

Ref: review_responses.review_id > reviews.id [delete: cascade]
Ref: notifications.review_id > reviews.id [delete: cascade]

Ref: prompt_versions.prompt_id > prompts.id [delete: cascade]
Ref: review_responses.prompt_version_id > prompt_versions.id [delete: set null]

Ref: platform_admin_identities.platform_admin_id > platform_admins.id [delete: cascade]
Ref: platform_admin_auth_tokens.platform_admin_id > platform_admins.id [delete: cascade]
Ref: platform_admins.invited_by_platform_admin_id > platform_admins.id [delete: set null]
Ref: platform_settings.updated_by_platform_admin_id > platform_admins.id [delete: set null]
Ref: platform_activity_log.actor_platform_admin_id > platform_admins.id [delete: set null]
Ref: platform_activity_log.tenant_id > tenants.id [delete: set null]

Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: tenants.active_location_id > locations.id [delete: set null]

Ref: in_app_notifications.tenant_id > tenants.id [delete: cascade]
Ref: in_app_notifications.user_id > users.id [delete: cascade]
Ref: in_app_notifications.review_id > reviews.id [delete: cascade]
Ref: in_app_notifications.notification_id > notifications.id [delete: set null]

Ref: media.user_id > users.id [delete: cascade]
Ref: media.platform_admin_id > platform_admins.id [delete: cascade]

Ref: tenant_subscriptions.tenant_id - tenants.id [delete: cascade]
Ref: tenant_subscriptions.plan_id > billing_plans.id [delete: restrict]
Ref: billing_receipts.tenant_id > tenants.id [delete: cascade]
Ref: billing_receipts.refund_resolved_by_admin_id > platform_admins.id [delete: set null]


Table refresh_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar [unique, not null]
  expires_at timestamp [not null]
  revoked_at timestamp
  created_at timestamp [not null]

  indexes {
    user_id
  }
}

Table platform_settings {
  id smallint [pk, note: 'CHECK (id = 1)']
  microsoft_login_enabled boolean [not null, default: true]
  password_login_enabled boolean [not null, default: false, note: 'Off by default while email delivery may be unavailable']
  google_login_enabled boolean [not null, default: true]
  invite_members_enabled boolean [not null, default: true]
  notification_settings_enabled boolean [not null, default: false]
  updated_by_platform_admin_id uuid
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: 'Single-row table. At least one login method must be enabled.'
}

Table platform_activity_log {
  id uuid [pk]
  type platform_activity_type [not null]
  actor_platform_admin_id uuid
  actor_email varchar [not null]
  tenant_id uuid
  business_name varchar
  target_email varchar
  occurred_at timestamp [not null, default: `now()`]
  details jsonb

  indexes {
    occurred_at
    actor_platform_admin_id
    tenant_id
  }

  Note: 'Constraints on target_check enforce which fields are required per activity type.'
}

Table in_app_notifications {
  id uuid [pk]
  tenant_id uuid [not null]
  user_id uuid [not null]
  type in_app_notification_type [not null]
  title varchar [not null]
  description text
  review_id uuid
  notification_id uuid
  generation_group_id uuid
  read_at timestamp [note: 'NULL = unread']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    tenant_id
    review_id
    (user_id, created_at)
    user_id [note: 'partial index where read_at IS NULL']
    created_at
    read_at [note: 'partial index where read_at IS NOT NULL']
  }

  Note: 'Partial unique index on (user_id, type, review_id, generation_group_id) for deduplication.'
}

Table media {
  id uuid [pk]
  kind media_kind [not null]
  user_id uuid
  platform_admin_id uuid
  provider varchar [not null]
  provider_asset_id varchar [not null]
  url varchar [not null]
  mime_type varchar [not null]
  size_bytes integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: '''Exactly one owner must be set (CHECK constraint).
  Partial unique indexes: (user_id, kind) WHERE user_id IS NOT NULL, (platform_admin_id, kind) WHERE platform_admin_id IS NOT NULL.'''
}

Table billing_plans {
  id uuid [pk]
  code billing_plan_code [unique, not null]
  stripe_product_id varchar
  stripe_price_id varchar
  max_locations smallint
  max_ai_drafts_per_month smallint
  max_team_members smallint
  custom_prompts_enabled boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table tenant_subscriptions {
  id uuid [pk]
  tenant_id uuid [unique, not null]
  plan_id uuid [not null]
  stripe_customer_id varchar [unique]
  stripe_subscription_id varchar [unique]
  status subscription_status
  current_period_start timestamp
  current_period_end timestamp
  cancel_at_period_end boolean [not null, default: false]
  cancellation_source subscription_cancellation_source
  stripe_last_verified_at timestamp
  stripe_last_event_at timestamp
  checkout_started_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    plan_id
    status
  }
}

Table stripe_webhook_events {
  id varchar [pk]
  type varchar [not null]
  stripe_customer_id varchar
  processed_at timestamp [not null, default: `now()`]
}

Table billing_receipts {
  id uuid [pk]
  tenant_id uuid [not null]
  stripe_invoice_id varchar [unique, not null]
  stripe_subscription_id varchar
  amount_paid integer [not null]
  currency varchar [not null]
  invoice_number varchar
  paid_at timestamp [not null]
  paid_after_erasure_request boolean [not null, default: false]
  refund_resolved_at timestamp
  refund_resolved_by_admin_id uuid
  created_at timestamp [not null]

  indexes {
    tenant_id
    paid_at [note: 'partial index for unresolved post-erasure receipts']
  }
}
