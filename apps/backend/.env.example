# Common
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3002 # Comma-separated list of allowed origins for CORS

# Prometheus, Grafana, Promtail, Loki, Node Exporter, Opentelemetry, Jaeger
PROMETHEUS_PORT=9090
PROMETHEUS_PUSH_GATEWAY_PORT=9091
PROMTAIL_PORT=9080
NODE_EXPORTER_PORT=9100
NESTJS_METRICS_TARGET=host.docker.internal:3000 # For Production - 10.0.0.55:3000
NODE_EXPORTER_TARGET=node-exporter:9100 # For Production - 10.0.0.55:9100
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD="admin"
LOKI_PORT=3100
LOKI_API_TOKEN="admin"
OTLP_PORT=4318
OTEL_SERVICE_NAME=nestjs-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces # For Production - 10.0.0.55:4318
JAEGER_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAGER_URL=http://localhost:16686

# Redis (For Queuing System)
REDIS_HOST=127.0.0.1 # (Or 'redis')
REDIS_PORT=6379
REDIS_PASSWORD="your_password_here" # Optional, if you want to enable authentication
REDIS_TLS_ENABLED=false # Redis TLS is not enabled by default

# PG Database
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT=5432
POSTGRES_HOST="127.0.0.1"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres" # Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Pagination
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=10

# External Links
GRAFANA_URL=http://localhost:3001
APP_LOGS_URL=http://localhost:9080/targets
DEV_DOCS_URL=http://localhost:3005
SERVICES_HEALTH_URL=http://localhost:3000/health/health-ui

# Auth (JWT)
# Generate real values with: openssl rand -base64 48
# These placeholders are USABLE locally but production refuses to boot on any value containing
# "change-in-production" (see env-config.module.ts) — so a prod deploy cannot accidentally run on them.
JWT_SECRET=local-dev-only-jwt-secret-change-in-production
JWT_REFRESH_SECRET=local-dev-only-jwt-refresh-secret-change-in-production # required in production, must differ from JWT_SECRET

# Auth (signup / verification)
# Optional — not read by the backend yet (reserved for OAuth redirect URLs). The web app
# runs on port 3002; 3001 is Grafana.
FRONTEND_URL=http://localhost:3002
VERIFY_EMAIL_OTP_TTL_MINUTES=10
# Dev-only: fixes the emailed signup/login verification OTP to this value instead of a random
# one, so it can be exercised without reading a real email. Leave unset in production — the app
# refuses to boot if this is set when NODE_ENV=production.
DEV_VERIFY_EMAIL_TOKEN=000000

# There is no dev *tenant* seed. The only seed is the root platform admin, created by
# `pnpm db:seed:admin` (src/db/seeds/seed-platform-admin.ts) from the ROOT_ADMIN_* values above.
# It used to be a migration with the password committed in plain text; it is a script precisely
# so that can never recur, since SQL cannot read an env var. For a working tenant owner, create
# one through the API after migrating, which also provisions its default prompts:
#
#   curl -sX POST localhost:3000/v1/auth/signup -H 'Content-Type: application/json' \
#     -d '{"businessName":"Dev Tenant","ownerName":"Dev Owner",
#          "email":"owner@example.com","password":"Owner@123456"}'
#   curl -sX POST localhost:3000/v1/auth/verify-email -H 'Content-Type: application/json' \
#     -d '{"email":"owner@example.com","otp":"'"$DEV_VERIFY_EMAIL_TOKEN"'"}'

# Auth (OAuth - Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same-origin with the web app, like GBP_CALLBACK_URL below; must match a redirect URI on the OAuth client.
GOOGLE_CALLBACK_URL=http://localhost:3002/v1/auth/google/callback

# Auth (OAuth - Microsoft Entra ID). One-time Azure setup is in
# apps/documentation/docs/backend/auth/microsoft-login-design.md — in particular the `email` and
# `xms_edov` optional ID-token claims: without them every Microsoft sign-in is refused.
MICROSOFT_CLIENT_ID=
# The secret's Value, not its ID.
MICROSOFT_CLIENT_SECRET=
# Same-origin with the web app, like GBP_CALLBACK_URL below; must match a redirect URI on the Azure app.
MICROSOFT_CALLBACK_URL=http://localhost:3002/v1/auth/microsoft/callback
# Optional. Defaults to https://login.microsoftonline.com/common; production only accepts a
# https://login.microsoftonline.com/<tenant> authority.
MICROSOFT_AUTHORITY=

# Google Business Profile (review data — deliberately NOT the GOOGLE_* pair above; different
# scopes, and one shared client would mean revoking review access also breaks sign-in).
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
# Points at the WEB app's origin, not the API's: /v1/* is rewritten to the backend by
# apps/web/next.config.ts, so the OAuth round trip stays same-origin with the app and the
# gbp_oauth_sid state cookie is first-party — the same arrangement the auth cookies rely on.
GBP_CALLBACK_URL=http://localhost:3002/v1/connections/google/callback
# HMAC key for the OAuth `state` blob. Required in production (boot refuses without it).
GBP_STATE_SECRET=local-dev-only-gbp-state-secret-change-in-production
# base64-encoded 32 bytes — encrypts provider refresh tokens at rest in the local Redis
# credential store. Generate with: openssl rand -base64 32
# The value below is exactly 32 bytes once decoded (so it works out of the box locally), and its
# encoded form contains the same "change-in-production" marker env-config.module.ts refuses to
# boot production on — unlike a value that merely *looks* like real random key material, which is
# indistinguishable from an already-rotated one to anyone reading a diff.
CREDENTIAL_ENCRYPTION_KEY=bG9jYWwtZGV2LWNoYW5nZS1pbi1wcm9kdWN0aW9uLXg=

# Email
EMAIL_PROVIDER=smtp # 'smtp' | 'ses'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Deployment Target (docker-compose.yml [local] vs docker-compose.floci.yml [AWS emulation])
DEPLOYMENT_TARGET=local # 'local' | 'aws'
FLOCI_PORT=4566
FLOCI_ENDPOINT=http://localhost:4566 # Only read when DEPLOYMENT_TARGET=aws
SECRETS_MANAGER_SECRET_ID=nestjs-app/development # Only read when DEPLOYMENT_TARGET=aws

# SQS queue URLs (DEPLOYMENT_TARGET=aws only — Terraform writes these into Secrets Manager
# directly; they're only listed here for reference/manual testing against real AWS). Keys are
# derived from QueueName (src/background/constants/job.constant.ts) — only EMAIL, DEAD_LETTER,
# CRON, REVIEW_SYNC, and REVIEW_POST queues currently exist.
EMAIL_QUEUE_URL=
DEAD_LETTER_QUEUE_URL=
CRON_QUEUE_URL=
REVIEW_SYNC_QUEUE_URL=
REVIEW_POST_QUEUE_URL=

# Root platform admin, created by `pnpm db:seed:admin` (which `local:up` runs for you).
# This is the only identity with no other creation path — every later admin is invited by an
# existing one — so a fresh database needs it to reach the Super Admin area at all.
# The seed is idempotent and never rewrites an existing root admin's password.
# In any shared or production environment, set these to real values and keep them out of git.
# Unlike the JWT secrets above, ROOT_ADMIN_PASSWORD's shipped value below is NOT usable as-is —
# the seed script refuses it outright — because this is a live login credential, not just a
# secret the app needs some value for; there is no safe "usable but insecure" default for it.
ROOT_ADMIN_EMAIL=root-admin@example.com
ROOT_ADMIN_PASSWORD=change-this-before-first-run

# Media storage (profile avatar upload) — Cloudinary. Required in production; elsewhere uploads answer 503 until all three
# are set. Create a free account at cloudinary.com and copy them from the dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Billing (Stripe). PAYMENT_FEATURE_ENABLED is a deploy-level master switch that must be 'true' for checkout to be
# reachable at all, on top of the admin-toggleable platform_settings.billing_enabled DB flag. Leave it false until you have
# Stripe keys: with it on, STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are required (and always in production).
PAYMENT_FEATURE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PAID=

# AI reply generation — AiProvider (src/api/ai/providers/), selected by AiModule's factory.
# 'azure' is the default and intended production provider (GDPR/westeurope requirement, PLAN.md
# §5); 'openrouter' remains a working secondary option. OPENROUTER_MODEL has no default —
# OpenRouter's free-tier catalog changes over time, so paste a model slug from
# https://openrouter.ai/models yourself, e.g. nvidia/nemotron-3-super-120b-a12b:free.

AI_PROVIDER=azure
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Azure OpenAI (only read when AI_PROVIDER=azure). AZURE_OPENAI_REGION must be 'westeurope' — a
# GDPR requirement for this engagement (PLAN.md §5), validated by both the Joi schema and
# AzureOpenAiProvider's own constructor.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_REGION=westeurope

# GDPR erasure (team-member removal / tenant erasure) — days between a removal/erasure request and
# the nightly ERASURE_PURGE cron job actually anonymizing the affected user(s). Access is revoked
# immediately on request; only this grace period gates the irreversible step.
ERASURE_GRACE_PERIOD_DAYS=21
