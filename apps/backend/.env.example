# Common
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3002 # Comma-separated list of allowed origins for CORS

# Prometheus, Grafana, Promtail, Loki, Node Exporter, Opentelemetry, Jaeger
PROMETHEUS_PORT=9090
PROMETHEUS_PUSH_GATEWAY_PORT=9091
PROMTAIL_PORT=9080
NODE_EXPORTER_PORT=9100
NESTJS_METRICS_TARGET=host.docker.internal:3000 # For Production - 10.0.0.55:3000
NODE_EXPORTER_TARGET=node-exporter:9100 # For Production - 10.0.0.55:9100
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD="admin"
LOKI_PORT=3100
LOKI_API_TOKEN="admin"
OTLP_PORT=4318
OTEL_SERVICE_NAME=nestjs-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces # For Production - 10.0.0.55:4318
JAEGER_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAGER_URL=http://localhost:16686

# Redis (For Queuing System)
REDIS_HOST=127.0.0.1 # (Or 'redis')
REDIS_PORT=6379
REDIS_PASSWORD="your_password_here" # Optional, if you want to enable authentication
REDIS_TLS_ENABLED=false # Redis TLS is not enabled by default

# PG Database
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT=5432
POSTGRES_HOST="127.0.0.1"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres" # Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Pagination
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=10

# External Links
GRAFANA_URL=http://localhost:3001
APP_LOGS_URL=http://localhost:9080/targets
DEV_DOCS_URL=http://localhost:3005
SERVICES_HEALTH_URL=http://localhost:3000/health/health-ui

# Auth (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production # required in production, must differ from JWT_SECRET

# Auth (signup / verification)
# Optional — not read by the backend yet (reserved for OAuth redirect URLs). The web app
# runs on port 3002; 3001 is Grafana.
FRONTEND_URL=http://localhost:3002
VERIFY_EMAIL_OTP_TTL_MINUTES=10
# Dev-only: fixes the emailed signup/login verification OTP to this value instead of a random
# one, so it can be exercised without reading a real email. Leave unset in production — the app
# refuses to boot if this is set when NODE_ENV=production.
DEV_VERIFY_EMAIL_TOKEN=000000

# Dev-only: consumed by `pnpm db:seed` (src/db/seeds/002_admin_user.sql), not by the app itself.
# Seeds a ready-to-use owner account with this email/password so local testing doesn't require
# going through signup + email verification. Refused when NODE_ENV=production.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=Admin@123456

# Auth (OAuth - Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# Email
EMAIL_PROVIDER=smtp # 'smtp' | 'ses'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Deployment Target (docker-compose.yml [local] vs docker-compose.floci.yml [AWS emulation])
DEPLOYMENT_TARGET=local # 'local' | 'aws'
FLOCI_PORT=4566
FLOCI_ENDPOINT=http://localhost:4566 # Only read when DEPLOYMENT_TARGET=aws
SECRETS_MANAGER_SECRET_ID=nestjs-app/development # Only read when DEPLOYMENT_TARGET=aws

# SQS queue URLs (DEPLOYMENT_TARGET=aws only — Terraform writes these into Secrets Manager
# directly; they're only listed here for reference/manual testing against real AWS). Keys are
# derived from QueueName (src/background/constants/job.constant.ts) — only EMAIL, DEAD_LETTER,
# and CRON queues currently exist.
EMAIL_QUEUE_URL=
DEAD_LETTER_QUEUE_URL=
CRON_QUEUE_URL=
