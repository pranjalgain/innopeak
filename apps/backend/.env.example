# Common
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001 # Comma-separated list of allowed origins for CORS

# Prometheus, Grafana, Promtail, Loki, Node Exporter, Opentelemetry, Jaeger
PROMETHEUS_PORT=9090
PROMETHEUS_PUSH_GATEWAY_PORT=9091
PROMTAIL_PORT=9080
NODE_EXPORTER_PORT=9100
NESTJS_METRICS_TARGET=host.docker.internal:3000 # For Production - 10.0.0.55:3000
NODE_EXPORTER_TARGET=node-exporter:9100 # For Production - 10.0.0.55:9100
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD="admin"
LOKI_PORT=3100
LOKI_API_TOKEN="admin"
OTLP_PORT=4318
OTEL_SERVICE_NAME=nestjs-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces # For Production - 10.0.0.55:4318
JAEGER_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAGER_URL=http://localhost:16686

# Redis (For Queuing System)
REDIS_HOST=127.0.0.1 # (Or 'redis')
REDIS_PORT=6379
REDIS_PASSWORD="your_password_here" # Optional, if you want to enable authentication
REDIS_TLS_ENABLED=false # Redis TLS is not enabled by default

# PG Database
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT=5432
POSTGRES_HOST="127.0.0.1"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres" # Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Pagination
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=10

# External Links
GRAFANA_URL=http://localhost:3001
APP_LOGS_URL=http://localhost:9080/targets
DEV_DOCS_URL=http://localhost:3005
SERVICES_HEALTH_URL=http://localhost:3000/health/health-ui

# Auth (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Auth (OAuth - Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# Auth (OAuth - GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/v1/auth/github/callback

# Auth (OAuth - Apple)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Auth (MFA)
MFA_ENCRYPTION_KEY=your-32-char-encryption-key-here

# Media
STORAGE_PROVIDER=cloudinary # 'cloudinary' | 's3'

# Media (S3) - credentials reused from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_PROVIDER=smtp # 'smtp' | 'ses'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Notifications (FCM)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# AI
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-sonnet-5
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=claude

# Deployment Target (docker-compose.yml [local] vs docker-compose.floci.yml [AWS emulation])
DEPLOYMENT_TARGET=local # 'local' | 'aws'
FLOCI_PORT=4566
FLOCI_ENDPOINT=http://localhost:4566 # Only read when DEPLOYMENT_TARGET=aws
SECRETS_MANAGER_SECRET_ID=nestjs-app/development # Only read when DEPLOYMENT_TARGET=aws

# SQS queue URLs (DEPLOYMENT_TARGET=aws only — Terraform writes these into Secrets Manager
# directly; they're only listed here for reference/manual testing against real AWS)
EMAIL_QUEUE_URL=
NOTIFICATION_QUEUE_URL=
WEBHOOK_QUEUE_URL=
DEAD_LETTER_QUEUE_URL=
CRON_QUEUE_URL=
