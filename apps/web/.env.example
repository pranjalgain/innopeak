# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values
# For development, you can use the provided defaults where applicable

# ==============================================================================
# SERVER ENVIRONMENT
# ==============================================================================

# Application Environment
NODE_ENV=development
ANALYZE=false

# ==============================================================================
# CLIENT ENVIRONMENT (Public - exposed to browser)
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_TITLE="InnoPeak"
NEXT_PUBLIC_APP_NAME="InnoPeak"
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_APP_DESCRIPTION="AI-assisted Google Business Profile review management"
NEXT_PUBLIC_APP_CATEGORY="app"
NEXT_PUBLIC_APP_KEYWORDS="reviews,google-business-profile,ai-replies"

# Base URL of the NestJS backend API (apps/backend) — its own PORT, not this app's. Where the Next server proxies /v1/*; server-side only
# (it was NEXT_PUBLIC_API_URL, which is still read as a fallback).
API_URL=http://localhost:3000

# ==============================================================================
# BILLING (Optional — only needed for in-app card entry in Settings → Billing)
# ==============================================================================

# Stripe publishable key (safe to expose to the browser, unlike the secret key) — same Stripe
# account as apps/backend's STRIPE_SECRET_KEY. Get it from
# https://dashboard.stripe.com/test/apikeys. Only used with the backend's Stripe keys set;
# the in-app "update card" flow shows a friendly error without it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# ERROR REPORTING (Optional for development)
# ==============================================================================

# There is no analytics or tag manager in the app. The only third party it contacts from the browser is Sentry, and only when a DSN is set.

# Sentry Error Tracking (Optional for development)
# Errors are reported only when a DSN is set (there is no default DSN, so no data goes to anyone else's project). No PII, no session
# replay, cookies and credentials are stripped. Create the project in YOUR Sentry organisation.
NEXT_PUBLIC_SENTRY_DSN=
# Fraction of server requests traced (0 = none). Optional.
SENTRY_TRACES_SAMPLE_RATE=0
# Source-map upload at build time: all three are needed. Maps are uploaded to Sentry and removed from the build, never served publicly.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ==============================================================================
# DEVELOPMENT NOTES
# ==============================================================================
#
# QUICK START (Minimal setup):
# 1. Copy this file to .env
# 2. Keep all defaults (no analytics)
# 3. Run: pnpm dev
#
# FULL SETUP (All features):
# 1. Copy this file to .env
# 2. Sign up for PostHog (free) and fill in POSTHOG_* variables
# 3. Sign up for Sentry (free) and fill in SENTRY_AUTH_TOKEN
# 4. Get GTM container ID and fill in NEXT_PUBLIC_GTM_KEY
# 5. Run: pnpm dev
#
