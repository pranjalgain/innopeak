# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
/out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings
.docusaurus
.husky

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

# Stray per-package lockfiles — apps/* are pnpm workspace members,
# so the root pnpm-lock.yaml is the only real one.
apps/*/pnpm-lock.yaml
libs/*/pnpm-lock.yaml

# Local knowledge-graph output — do not commit
graphify-out/

# Generated by next-openapi-gen: the working cache, plus the spec itself, which
# `/reference` serves at runtime. Both are produced by `pnpm openapi:generate`,
# which now runs as part of `pnpm --dir apps/web build` as well as `dev`.
apps/web/.openapi-gen/
apps/web/public/openapi.json
